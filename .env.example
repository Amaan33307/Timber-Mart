# Copy this file to .env and fill in your values.

# Leave MONGO_URI commented out to use local MongoDB
# (mongodb://127.0.0.1:27017/timber_mart).
# For MongoDB Atlas, remove the # and paste your link
# (keep /timber_mart before the "?"):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/timber_mart?retryWrites=true&w=majority

# Any long random text, used to sign login cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Port for running locally (npm start)
PORT=3000
