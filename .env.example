# Copy this file to .env and fill in your values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Replace USER, PASSWORD and the cluster address. Keep /timber_mart before the "?".
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/timber_mart?retryWrites=true&w=majority

# Any long random text, used to sign login cookies
SESSION_SECRET=change-this-to-a-long-random-string

# Port for running locally (npm start)
PORT=3000
