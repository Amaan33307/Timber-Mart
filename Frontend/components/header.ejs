    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >


    <!-- Attendance -->

    <link
        rel="stylesheet"
        href="/css/attendance.css"
    >


    <!-- Workers -->

    <link
        rel="stylesheet"
        href="/css/workers.css"
    >


    <!-- Admin -->

    <link
        rel="stylesheet"
        href="/css/admin.css"
    >


    <!-- Settings -->

    <link
        rel="stylesheet"
        href="/css/settings.css"
    >


    <!-- Shared helpers (TM.*), loaded first so page scripts can use them -->

    <script src="/js/script.js"></script>

