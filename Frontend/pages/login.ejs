<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Login | Timber Mart
    </title>


    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >


    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <link
        rel="stylesheet"
        href="/css/login.css"
    >

</head>


<body class="login-page">


    <div class="login-container">


        <!-- BRAND SIDE -->

        <div class="login-brand">

            <div class="brand-icon">
                <i class="bi bi-door-open"></i>
            </div>


            <h1>
                Timber Mart
            </h1>


            <div class="brand-line"></div>


            <h2>
                MANAGEMENT SYSTEM
            </h2>


            <p>
                Manage your workforce,
                attendance and daily
                operations with simplicity
                and efficiency.
            </p>

        </div>


        <!-- LOGIN SIDE -->

        <div class="login-form-section">

            <div class="login-form-wrapper">


                <p class="login-label">
                    TIMBER MART
                </p>


                <h1>
                    Welcome Back
                </h1>


                <p class="login-subtitle">
                    Sign in to your Timber Mart account
                </p>


                <!-- ERROR MESSAGE -->

                <div
                    id="loginMessage"
                    class="login-message"
                ></div>


                <form id="loginForm">


                    <!-- EMAIL -->

                    <div class="login-field">

                        <label>
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                name="email"
                                id="loginEmail"
                                placeholder="Enter your email"
                                autocomplete="email"
                                required
                            >

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="login-field">

                        <label>
                            Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                name="password"
                                id="loginPassword"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                id="togglePassword"
                                class="password-toggle"
                            >
                                <i class="bi bi-eye"></i>
                            </button>

                        </div>

                    </div>


                    <!-- OPTIONS -->

                    <div class="login-options">

                        <label>

                            <input
                                type="checkbox"
                                name="remember"
                            >

                            Remember me

                        </label>


                        <a href="#" id="forgotPasswordLink">
                            Forgot Password?
                        </a>

                    </div>


                    <!-- LOGIN -->

                    <button
                        type="submit"
                        class="login-btn"
                        id="loginButton"
                    >

                        <span>
                            Login
                        </span>

                        <i class="bi bi-arrow-right"></i>

                    </button>


                </form>


                <div class="register-link">

                    Don't have an account?

                    <a href="/register">
                        Create Account
                    </a>

                </div>


            </div>

        </div>

    </div>


    <script src="/js/login.js"></script>

</body>

</html>