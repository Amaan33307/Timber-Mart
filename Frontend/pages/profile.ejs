<%- include("../components/header") %>

<%
    const initials = user.name
        .trim()
        .split(/\s+/)
        .slice(0, 2)
        .map((part) => part.charAt(0).toUpperCase())
        .join("");

    const joined = new Date(user.createdAt);

    const joinedText = joined.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "long",
        year: "numeric"
    });

    // Time since joining, e.g. "1 Year 7 Months"
    const now = new Date();
    let months =
        (now.getFullYear() - joined.getFullYear()) * 12 +
        (now.getMonth() - joined.getMonth());
    if (now.getDate() < joined.getDate()) { months -= 1; }
    months = Math.max(months, 0);
    const years = Math.floor(months / 12);
    const restMonths = months % 12;
    const serviceParts = [];
    if (years) { serviceParts.push(years + (years === 1 ? " Year" : " Years")); }
    if (restMonths) { serviceParts.push(restMonths + (restMonths === 1 ? " Month" : " Months")); }
    const serviceText = serviceParts.length ? serviceParts.join(" ") : "Less than a month";

    const roleText = user.role === "admin" ? "Administrator" : "Worker";
    const isActive = user.status === "active";
%>

<div class="dashboard-page">

    <%- include("../components/navbar") %>

    <div class="dashboard-layout">

        <%- include("../components/sidebar") %>

        <main class="dashboard-content">

            <div class="page-header">

                <div>

                    <p class="dashboard-label">
                        MY ACCOUNT
                    </p>

                    <h1>My Profile</h1>

                    <p>
                        View your personal and employment information.
                    </p>

                </div>

                <a
                    href="/settings"
                    class="add-worker-btn"
                    id="editProfileBtn"
                >
                    <i class="bi bi-pencil"></i>
                    Edit Profile
                </a>

            </div>


            <div class="row g-4">

                <!-- Profile -->
                <div class="col-lg-4">

                    <div class="dashboard-card profile-main-card">

                        <div class="profile-main-avatar">
                            <%= initials %>
                        </div>

                        <h2><%= user.name %></h2>

                        <p class="profile-role">
                            <%= roleText %> · <%= user.department || "--" %>
                        </p>

                        <span class="worker-status <%= isActive ? 'active' : 'inactive' %>">
                            <%= isActive ? "Active" : "Inactive" %>
                        </span>


                        <div class="profile-divider"></div>


                        <div class="profile-contact">

                            <div>
                                <i class="bi bi-envelope"></i>
                                <span>
                                    <%= user.email %>
                                </span>
                            </div>

                            <div>
                                <i class="bi bi-telephone"></i>
                                <span>
                                    <%= user.phone %>
                                </span>
                            </div>

                            <div>
                                <i class="bi bi-person-badge"></i>
                                <span>
                                    <%= user.workerId || "Admin account" %>
                                </span>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Details -->
                <div class="col-lg-8">

                    <div class="dashboard-card">

                        <div class="card-heading">

                            <div>

                                <h3>Personal Information</h3>

                                <p>
                                    Your registered information
                                </p>

                            </div>

                        </div>


                        <div class="worker-information-grid">

                            <div class="information-item">

                                <span>Full Name</span>

                                <strong>
                                    <%= user.name %>
                                </strong>

                            </div>

                            <div class="information-item">

                                <span>Email</span>

                                <strong>
                                    <%= user.email %>
                                </strong>

                            </div>

                            <div class="information-item">

                                <span>Phone</span>

                                <strong>
                                    <%= user.phone %>
                                </strong>

                            </div>

                            <div class="information-item">

                                <span>Worker ID</span>

                                <strong>
                                    <%= user.workerId || "--" %>
                                </strong>

                            </div>

                            <div class="information-item">

                                <span>Department</span>

                                <strong>
                                    <%= user.department || "--" %>
                                </strong>

                            </div>

                            <div class="information-item">

                                <span>Joining Date</span>

                                <strong>
                                    <%= joinedText %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- Work Information -->
                    <div class="dashboard-card profile-work-card">

                        <div class="card-heading">

                            <div>

                                <h3>Work Information</h3>

                                <p>
                                    Employment information
                                </p>

                            </div>

                        </div>


                        <div class="profile-work-grid">

                            <div>
                                <span>Role</span>
                                <strong><%= roleText %></strong>
                            </div>

                            <div>
                                <span>Department</span>
                                <strong><%= user.department || "--" %></strong>
                            </div>

                            <div>
                                <span>Experience</span>
                                <strong><%= serviceText %></strong>
                            </div>

                            <div>
                                <span>Current Status</span>
                                <strong class="<%= isActive ? 'active-text' : 'inactive-text' %>">
                                    <%= isActive ? "Active" : "Inactive" %>
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </main>

    </div>

</div>

<%- include("../components/footer") %>
