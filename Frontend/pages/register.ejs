<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Register | Timber Mart
    </title>


    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >


    <!-- Main CSS -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <!-- Login / Register CSS -->
    <link
        rel="stylesheet"
        href="/css/login.css"
    >

</head>


<body class="login-page">


    <div class="login-container">


        <!-- =====================================
             LEFT BRAND SECTION
        ====================================== -->

        <div class="login-brand">

            <div class="brand-icon">

                <i class="bi bi-door-open"></i>

            </div>


            <h1>
                Timber Mart
            </h1>


            <div class="brand-line"></div>


            <h2>
                MANAGEMENT SYSTEM
            </h2>


            <p>
                Join the Timber Mart workforce
                and manage your work, attendance
                and employee information easily.
            </p>

        </div>


        <!-- =====================================
             RIGHT REGISTER SECTION
        ====================================== -->

        <div class="login-form-section">

            <div class="login-form-wrapper">


                <p class="login-label">
                    TIMBER MART
                </p>


                <h1>
                    Create Account
                </h1>


                <p class="login-subtitle">
                    Register as a Timber Mart worker
                </p>


                <!-- MESSAGE -->

                <div
                    id="registerMessage"
                    class="login-message"
                ></div>


                <!-- =================================
                     REGISTER FORM
                ================================== -->

                <form id="registerForm">


                    <!-- NAME -->

                    <div class="login-field">

                        <label>
                            Full Name
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person"></i>

                            <input
                                type="text"
                                name="name"
                                placeholder="Enter your full name"
                                required
                            >

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="login-field">

                        <label>
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input
                                type="email"
                                name="email"
                                placeholder="Enter your email"
                                required
                            >

                        </div>

                    </div>


                    <!-- PHONE -->

                    <div class="login-field">

                        <label>
                            Phone Number
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <input
                                type="tel"
                                name="phone"
                                placeholder="10-digit mobile number"
                                required
                            >

                        </div>

                    </div>


                    <!-- DEPARTMENT -->

                    <div class="login-field">

                        <label>
                            Department
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-building"></i>

                            <select
                                name="department"
                                required
                                style="
                                    width: 100%;
                                    height: 52px;
                                    padding: 0 48px;
                                    border: 1px solid #ddd3c9;
                                    border-radius: 10px;
                                    background: #ffffff;
                                    color: #3e3128;
                                    font-size: 14px;
                                    outline: none;
                                "
                            >

                                <option value="">
                                    Select department
                                </option>

                                <option value="Carpentry">
                                    Carpentry
                                </option>

                                <option value="Polishing">
                                    Polishing
                                </option>

                                <option value="Finishing">
                                    Finishing
                                </option>

                                <option value="Production">
                                    Production
                                </option>

                                <option value="Warehouse">
                                    Warehouse
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- PASSWORD -->

                    <div class="login-field">

                        <label>
                            Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-lock"></i>

                            <input
                                type="password"
                                name="password"
                                id="registerPassword"
                                placeholder="Create a password (min. 6 characters)"
                                minlength="6"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                id="toggleRegisterPassword"
                                class="password-toggle"
                            >

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="login-field">

                        <label>
                            Confirm Password
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-shield-lock"></i>

                            <input
                                type="password"
                                id="confirmPassword"
                                placeholder="Confirm your password"
                                autocomplete="new-password"
                                required
                            >

                            <button
                                type="button"
                                id="toggleConfirmPassword"
                                class="password-toggle"
                            >

                                <i class="bi bi-eye"></i>

                            </button>

                        </div>

                    </div>


                    <!-- REGISTER BUTTON -->

                    <button
                        type="submit"
                        class="login-btn"
                        id="registerButton"
                    >

                        <span>
                            Create Account
                        </span>

                        <i class="bi bi-arrow-right"></i>

                    </button>


                </form>


                <!-- LOGIN LINK -->

                <div class="register-link">

                    Already have an account?

                    <a href="/">
                        Login
                    </a>

                </div>


            </div>

        </div>

    </div>


    <script src="/js/register.js"></script>

</body>

</html>